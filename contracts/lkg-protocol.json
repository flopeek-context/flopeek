{
  "schemaVersion": "flopeek-lkg-protocol/v2",
  "candidate": {
    "schemaVersion": "flopeek-last-known-good-candidate/v2",
    "contextBinding": "context-definition-revision-and-canonical-basis-fingerprint",
    "expectedBehaviorFingerprint": "sha256(contract-id-and-exact-utf8-expectedBehavior)",
    "integrityStatuses": ["complete", "partial", "invalid"],
    "confirmationRequires": "complete-integrity-and-applicable-basis"
  },
  "reviewPacket": {
    "schemaVersion": "flopeek-last-known-good-review-packet/v2",
    "includes": ["context", "candidate", "state", "applicability", "candidate-to-current-structural-delta", "confirmability"],
    "candidateSelection": "pending-first-otherwise-active",
    "applicabilitySemantics": {
      "packetApplicability": "selected-review-candidate",
      "stateApplicability": "effective-state-active-first-otherwise-pending",
      "stateReduction": "complete-context-candidate-and-event-stream"
    },
    "sourceBody": false,
    "runtimeClaims": false,
    "causalClaims": false
  },
  "event": {
    "schemaVersion": "flopeek-last-known-good-event/v1",
    "types": ["PROPOSE", "CONFIRM", "REJECT", "REVOKE"],
    "forbiddenTypes": ["SUPERSEDE"],
    "onePendingCandidate": true,
    "oneActiveCandidate": true
  },
  "state": {
    "schemaVersion": "flopeek-last-known-good-state/v2",
    "lifecycleStatuses": ["none", "pending", "active", "inactive", "corrupt"],
    "applicabilityStatuses": [
      "applicable",
      "out-of-lineage",
      "repository-mismatch",
      "context-basis-mismatch",
      "basis-unavailable",
      "contract-incompatible",
      "unavailable"
    ],
    "authority": "candidate-and-event-reduction",
    "invariants": [
      "at-most-one-pending",
      "at-most-one-active",
      "context-pointer-equals-active-candidate-or-null",
      "materialized-state-must-match-reduction"
    ]
  },
  "transitionMatrix": {
    "PROPOSE": "creates-pending-only",
    "CONFIRM": "targets-pending-and-optionally-replaces-active",
    "REJECT": "targets-pending-and-preserves-active",
    "REVOKE": "targets-active-and-clears-active"
  },
  "confirmation": {
    "requiresPendingCandidate": true,
    "directConfirmation": false,
    "invalidReason": "lkg-confirm-target-not-pending"
  },
  "graphReuse": {
    "structuralCompatibility": [
      "graph-metadata-and-evidence-contract",
      "canonical-resolution-entry-related-test-evidence",
      "nodes",
      "edges",
      "flows"
    ],
    "exactSourceAuthority": "graph_observations.source_manifest_json",
    "exactSourceExcludedFromReuse": [
      "bytes",
      "raw-source-hash",
      "source-hash",
      "source-position",
      "serialized-facts"
    ]
  },
  "compatibility": {
    "protocolBindingSynthesis": false,
    "confirmerAttribution": "confirm-event-only"
  },
  "validation": {
    "integrity": ["complete", "partial", "invalid"],
    "applicability": "recomputed-at-read-and-use",
    "revisionAuthority": "graph_observations.git_revision",
    "graphVersionSourceRevisionAuthority": false
  },
  "concurrency": {
    "expectedTipRequired": true,
    "idempotencyRequired": true,
    "staleTipReason": "stale-lifecycle-tip",
    "requestIdentity": "canonical-original-typed-request-before-mutable-resolution",
    "retryBehavior": "return-original-result-without-revalidation",
    "legacyReceiptBehavior": "legacy-lkg-idempotency-replay-unavailable",
    "conflictingRetryReason": "idempotency-conflict"
  },
  "trust": {
    "proposalTransports": ["untrusted-jsonl", "local-cli"],
    "humanTransitions": ["trusted-local-process-api"],
    "officialHumanSurface": "local-cli",
    "actorIdentity": "caller-attributed-not-authenticated"
  },
  "contextInterop": {
    "basisSchemaVersion": "flopeek-diagnostic-context-basis/v1",
    "definitionRevision": "definition-fields-only",
    "memoryRevision": "assertion-stream-only",
    "applicabilityBinding": "context-basis-and-expected-behavior",
    "diagnosisPreservesActiveInapplicable": true
  },
  "history": {
    "schemaVersion": "flopeek-last-known-good-history/v1",
    "orderAuthority": "predecessor-event-chain",
    "timestampRole": "display-metadata-only",
    "defaultLimit": 128,
    "hardLimit": 1024
  },
  "migration": {
    "policy": "preserve-semantics-or-quarantine",
    "ambiguousReason": "legacy-lkg-semantics-ambiguous",
    "rawLegacyEvidence": "retained-read-only",
    "failClosed": true
  }
}
